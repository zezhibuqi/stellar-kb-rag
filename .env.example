# SiliconFlow（Embedding / Reranker）
SILICONFLOW_API_KEY=
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1

# DeepSeek（LLM 预设提供方）
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com

# 超算互联网 scnet（LLM 预设提供方：GLM-5-Base）
SCNET_API_KEY=
SCNET_BASE_URL=https://api.scnet.cn/api/llm/v1
SCNET_MODEL=GLM-5-Base

# 当前模型提供方默认值（管理员可在界面切换，DB 设置优先于该值）
LLM_PROVIDER=deepseek

# JWT
JWT_SECRET_KEY=
JWT_EXPIRATION_HOURS=168

# CORS
FLASK_CORS_ORIGINS=http://localhost:3000

# 数据路径（默认基于项目根目录解析）
CHROMA_PERSIST_DIR=./backend/data/chroma
DATABASE_URL=./backend/data/app.db
DATABASE_TIMEOUT=30

# 切片参数
MAX_CHUNK_SIZE=1024
MAX_CHUNK_OVERLAP=50

# 上传限制
UPLOAD_MAX_SIZE_MB=10

# LLM 生成参数（思考型模型如 GLM-5-Base 的推理也计入 max_tokens，
# 若长回答被截断报错，可将 LLM_MAX_TOKENS 调大，如 8192）
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=4096
