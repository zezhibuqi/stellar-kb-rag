# SiliconFlow（Embedding / Reranker）
SILICONFLOW_API_KEY=
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1

# DeepSeek（LLM 预设提供方）
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com

# 超算互联网 scnet（LLM 预设提供方：GLM-5-Base）
SCNET_API_KEY=
SCNET_BASE_URL=https://api.scnet.cn/api/llm/v1

# 小米（LLM 预设提供方：MIMO-V2.5 / MIMO-V2.5-Pro）
XIAOMI_API_KEY=
XIAOMI_BASE_URL=https://api.xiaomimimo.com/v1

# 当前模型提供方默认值（管理员可在界面切换，DB 设置优先于该值）
LLM_PROVIDER=deepseek

# ── 新增 LLM 提供方示例（以硅基流动为例；模型标识直接写在 llm.py 注册表）──
# 配套修改：backend/llm.py 的 _build_providers() 注册 + backend/config.py 配置项
# SILICONFLOW_LLM_KEY=sk-xxx
# SILICONFLOW_LLM_BASE_URL=https://api.siliconflow.cn/v1

# JWT
JWT_SECRET_KEY=
JWT_EXPIRATION_HOURS=168

# CORS
FLASK_CORS_ORIGINS=http://localhost:3000

# 数据路径（默认基于项目根目录解析）
CHROMA_PERSIST_DIR=./backend/data/chroma
DATABASE_URL=./backend/data/app.db
DATABASE_TIMEOUT=30

# 切片参数
MAX_CHUNK_SIZE=1024
MAX_CHUNK_OVERLAP=50

# 证据单元：注入上下文的原文范围上限（字符）
AGENT_EVIDENCE_MAX_CHARS=3000

# 会话上下文：服务端截取的最近轮数（每轮 2 条消息）
CHAT_HISTORY_TURNS=10

# 增强模式（编排式问答）
AGENT_MAX_SUB_QUESTIONS=8
AGENT_EVIDENCE_PER_SUB=2
AGENT_EVIDENCE_GLOBAL=10
AGENT_SEARCH_CANDIDATES=3
AGENT_SUB_TIMEOUT=60
AGENT_TOTAL_BUDGET=120
# 调用 token 预算：思考型模型先花推理预算再输出 JSON，需给足
AGENT_PLAN_MAX_TOKENS=10000
AGENT_SUB_ANSWER_MAX_TOKENS=6000

# 上传限制
UPLOAD_MAX_SIZE_MB=10

# LLM 生成参数（思考型模型如 GLM-5-Base 的推理也计入 max_tokens，
# 若长回答被截断报错，可将 LLM_MAX_TOKENS 调大，如 8192）
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=4096
