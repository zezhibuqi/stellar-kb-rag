# 环境变量与密钥
.env
.env.local
.env.*.local

# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/

# Node / Next.js
node_modules/
.next/
out/
npm-debug.log*

# 运行时数据（数据库、向量库、上传文件）
backend/data/*
!backend/data/.gitkeep
!backend/data/chroma/
!backend/data/chroma/.gitkeep
backend/data/chroma/*
!backend/data/chroma/.gitkeep
!backend/data/uploads/
!backend/data/uploads/.gitkeep
!backend/data/uploads/*/
!backend/data/uploads/*/.gitkeep
backend/data/uploads/*/*
!backend/data/uploads/*/.gitkeep

# 用户提供的原始 Markdown（按领域目录放置，不提交内容）
backend/markdown_src/*
!backend/markdown_src/.gitkeep
!backend/markdown_src/*/
!backend/markdown_src/*/.gitkeep
backend/markdown_src/*/*
!backend/markdown_src/*/.gitkeep

